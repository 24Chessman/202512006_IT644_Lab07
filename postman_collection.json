    {
      "name": "4 · Order Service — via Gateway",
      "description": "Order operations on /orders/* — routed through gateway → order-service.\norder-service internally calls user-service & product-service for validation.\nGateway path: {{gateway_url}}/orders/* → order-service /orders/*",
      "item": [
        {
          "name": "GET /orders — List All Orders",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/orders",
            "description": "Proxied: gateway → order-service. Returns [] on fresh start."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /orders — Create Order (Valid, Full Chain)",
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/orders",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
            },
            "description": "Full chain test:\n  Postman → gateway → order-service → user-service (validate)\n                                    → product-service (validate)\n  → 201 with userSnapshot + productSnapshot + totalPrice"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('orderId', body.id);",
                  "pm.test('Order has id', () => pm.expect(body.id).to.be.a('string'));",
                  "pm.test('Order has userSnapshot', () => pm.expect(body.userSnapshot).to.be.an('object'));",
                  "pm.test('Order has productSnapshot', () => pm.expect(body.productSnapshot).to.be.an('object'));",
                  "pm.test('Order has totalPrice', () => pm.expect(body.totalPrice).to.be.a('number'));",
                  "pm.test('totalPrice = price × qty', () => pm.expect(body.totalPrice).to.equal(2599.98));",
                  "pm.test('Status is confirmed', () => pm.expect(body.status).to.equal('confirmed'));",
                  "console.log('Created orderId:', body.id, '| totalPrice:', body.totalPrice);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /orders/:id — Get Order by ID",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/orders/{{orderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Correct order', () => {",
                  "    pm.expect(pm.response.json().id).to.equal(pm.collectionVariables.get('orderId'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "name": "5 · Gateway Error Scenarios",
      "description": "Tests for gateway centralized error handling.\n\n─── 503 TEST PROCEDURE ───\n1. Run:  docker stop user-service\n2. Send: 'GET /users — 503 user-service DOWN'\n3. Expect: 503 ServiceUnavailable (clean JSON, no hang/crash)\n4. Run:  docker start user-service\n5. Send: 'GET /users — Recovery'\n6. Expect: 200 []\n\n─── CLOUD 503 NOTE ───\nOn Render free tier you cannot stop individual services.\nThe cloud 503 can be demonstrated by temporarily setting\nUSER_SERVICE_URL to an invalid URL in the Render env panel,\nredeploying, and hitting GET /users.",
      "item": [
        {
          "name": "POST /orders — 404 Invalid userId",
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/orders",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"u999\",\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
            },
            "description": "Gateway → order-service → user-service returns 404 (u999 not found) → order-service returns 404 → gateway passes through → client gets 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error is NotFound', () => pm.expect(pm.response.json().error).to.equal('NotFound'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /orders — 404 Invalid productId",
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/orders",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"productId\": \"p999\",\n  \"quantity\": 1\n}"
            },
            "description": "Gateway → order-service → product-service returns 404 (p999 not found) → propagated as 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error is NotFound', () => pm.expect(pm.response.json().error).to.equal('NotFound'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /users — 503 user-service DOWN",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/users",
            "description": "PREREQUISITE: docker stop user-service\n\nGateway proxies to user-service, gets EAI_AGAIN (DNS gone), returns structured 503.\nGateway never hangs or crashes — always responds within 5s."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 503', () => pm.response.to.have.status(503));",
                  "const body = pm.response.json();",
                  "pm.test('Error is ServiceUnavailable', () => pm.expect(body.error).to.equal('ServiceUnavailable'));",
                  "pm.test('Has upstream field', () => pm.expect(body.upstream).to.be.a('string'));",
                  "pm.test('Message is descriptive', () => pm.expect(body.message).to.include('unavailable'));",
                  "console.log('503 response:', JSON.stringify(body));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /users — Recovery after restart",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/users",
            "description": "PREREQUISITE: docker start user-service\n\nGateway recovers automatically — no restart needed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 — recovered', () => pm.response.to.have.status(200));",
                  "pm.test('Response is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /nonexistent — 404 Unknown Gateway Route",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/nonexistent",
            "description": "Path not in the gateway routing table. Gateway returns its own 404 — no proxying attempted."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error is NotFound', () => pm.expect(pm.response.json().error).to.equal('NotFound'));",
                  "pm.test('hint present', () => pm.expect(pm.response.json().hint).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    }

  ]
}

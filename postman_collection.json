                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('productId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /orders — Cloud: Full Order Chain",
          "request": {
            "method": "POST",
            "url": "{{cloud_url}}/orders",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
            },
            "description": "Full cloud chain: cloud gateway → cloud order-service → cloud user-service + cloud product-service."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cloud: Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Cloud: Order confirmed', () => pm.expect(body.status).to.equal('confirmed'));",
                  "pm.test('Cloud: has totalPrice', () => pm.expect(body.totalPrice).to.be.a('number'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /health — Cloud: Config-driven URL Proof",
          "request": {
            "method": "GET",
            "url": "{{cloud_url}}/health",
            "description": "Verifies that the cloud gateway's upstream URLs are read from Render environment variables — not hard-coded. The 'upstreams' field shows the URLs configured via Render's env var panel."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cloud: upstreams are Render URLs', () => {",
                  "    const upstreams = pm.response.json().upstreams;",
                  "    const values = Object.values(upstreams);",
                  "    // All upstreams should be configured via env vars (Render URLs or internal)",
                  "    values.forEach(url => pm.expect(url).to.be.a('string').and.not.be.empty);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }

  ]

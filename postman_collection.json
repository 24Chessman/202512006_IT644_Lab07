    {
      "name": "5 · Gateway Error Scenarios",
      "description": "Tests for gateway error handling:\n  • 404 invalid upstream resource\n  • 503 ServiceUnavailable (gateway detects service is down)\n\n503 Test procedure:\n  1. Run: docker stop user-service\n  2. Send 'GET /users — 503 user-service DOWN'\n  3. Expect 503 ServiceUnavailable\n  4. Run: docker start user-service\n  5. Send 'GET /users — Recovery' → should return 200\n\nCloud 503 test: Cannot stop individual cloud services on free tier;\n  use a deliberately wrong URL to simulate: change USER_SERVICE_URL to\n  http://nonexistent:9999 in env, redeploy, and test.",
      "item": [
        {
          "name": "POST /orders — 404 Invalid userId",
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/orders",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"u999\",\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
            },
            "description": "Invalid userId. Gateway → order-service → user-service returns 404. Order service propagates 404 back through gateway."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error is NotFound', () => pm.expect(pm.response.json().error).to.equal('NotFound'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /orders — 404 Invalid productId",
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/orders",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"productId\": \"p999\",\n  \"quantity\": 1\n}"
            },
            "description": "Invalid productId. Gateway → order-service → product-service returns 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error is NotFound', () => pm.expect(pm.response.json().error).to.equal('NotFound'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /users — 503 user-service DOWN",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/users",
            "description": "PREREQUISITE: Stop user-service first: docker stop user-service\n\nGateway attempts to proxy to user-service, gets network error (EAI_AGAIN / ECONNREFUSED), returns clean 503 ServiceUnavailable — never hangs or crashes.\n\nAfter confirming 503, restart: docker start user-service"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 503', () => pm.response.to.have.status(503));",
                  "const body = pm.response.json();",
                  "pm.test('Error is ServiceUnavailable', () => pm.expect(body.error).to.equal('ServiceUnavailable'));",
                  "pm.test('Has upstream field', () => pm.expect(body.upstream).to.be.a('string'));",
                  "pm.test('Has path field', () => pm.expect(body.path).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /users — Recovery after restart",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/users",
            "description": "PREREQUISITE: user-service must be running (docker start user-service).\n\nConfirms gateway recovers automatically — no gateway restart needed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 — recovered', () => pm.response.to.have.status(200));",
                  "pm.test('Response is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /nonexistent — 404 Unknown Gateway Route",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/nonexistent",
            "description": "Path not in the gateway routing table. Gateway returns its own 404 (no proxying)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error is NotFound', () => pm.expect(pm.response.json().error).to.equal('NotFound'));"
                ]
              }
            }
          ]
        }
      ]
    },


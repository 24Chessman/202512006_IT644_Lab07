    {
      "name": "4 · Order Service — via Gateway",
      "description": "Order operations routed through the gateway at /orders/*. Order service internally calls user-service and product-service for validation.",
      "item": [
        {
          "name": "GET /orders — List All Orders",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/orders",
            "description": "Proxied to order-service. Returns [] on a fresh start."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /orders — Create Order (Valid)",
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/orders",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
            },
            "description": "Creates an order via the gateway. Gateway → order-service → user-service + product-service (internal validation). Full chain test."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('orderId', body.id);",
                  "pm.test('Order has id', () => pm.expect(body.id).to.be.a('string'));",
                  "pm.test('Order has userSnapshot', () => pm.expect(body.userSnapshot).to.be.an('object'));",
                  "pm.test('Order has productSnapshot', () => pm.expect(body.productSnapshot).to.be.an('object'));",
                  "pm.test('Order has totalPrice', () => pm.expect(body.totalPrice).to.be.a('number'));",
                  "pm.test('totalPrice correct', () => pm.expect(body.totalPrice).to.equal(2599.98));",
                  "pm.test('Status confirmed', () => pm.expect(body.status).to.equal('confirmed'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /orders/:id — Get Order by ID",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/orders/{{orderId}}",
            "description": "Fetches the order stored in orderId variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Correct order', () => pm.expect(pm.response.json().id).to.equal(pm.collectionVariables.get('orderId')));"
                ]
              }
            }
          ]
        }

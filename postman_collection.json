{
  "info": {
    "_postman_id": "lab07-api-gateway-collection",
    "name": "Microservices – Lab 7 (API Gateway)",
    "description": "Complete test collection for Lab 07 — API Gateway + Config-based Service Discovery.\n\nArchitecture:\n  Client/Postman → api-gateway (localhost:4000 / Render cloud)\n                   ├─ /users/*    → user-service    (internal)\n                   ├─ /products/* → product-service (internal)\n                   └─ /orders/*  → order-service   (internal)\n\nStart all services: docker compose up -d\n\nEnvironments:\n  • local:  gateway_url = http://localhost:4000\n  • cloud:  gateway_url = https://lab07-api-gateway.onrender.com\n\nTest order (recommended):\n  1. Gateway Health\n  2. User CRUD via Gateway\n  3. Product CRUD via Gateway\n  4. Order via Gateway (validates user + product)\n  5. Error scenarios: 503 (service down) via Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway_url",  "value": "http://localhost:4000",                          "description": "API Gateway base URL. Switch to Render cloud URL for cloud tests." },
    { "key": "cloud_url",    "value": "https://lab07-api-gateway.onrender.com",         "description": "Public Render cloud gateway URL for cloud re-run tests." },
    { "key": "userId",       "value": "u1",                                             "description": "Set automatically after POST /users" },
    { "key": "productId",    "value": "p1",                                             "description": "Set automatically after POST /products" },
    { "key": "orderId",      "value": "o1",                                             "description": "Set automatically after POST /orders" }
  ],
  "item": [

    {
      "name": "1 · Gateway Health & Info",
      "description": "Gateway-only endpoints — no proxying to upstream services.",
      "item": [
        {
          "name": "GET /health — Gateway Health Check",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/health",
            "description": "Returns gateway status, version, timestamp, and the upstream service URLs from environment config."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status is ok', () => pm.expect(pm.response.json().status).to.equal('ok'));",
                  "pm.test('service is api-gateway', () => pm.expect(pm.response.json().service).to.equal('api-gateway'));",
                  "pm.test('upstreams present', () => pm.expect(pm.response.json().upstreams).to.be.an('object'));",
                  "pm.test('has user-service URL', () => pm.expect(pm.response.json().upstreams['user-service']).to.be.a('string'));",
                  "pm.test('has product-service URL', () => pm.expect(pm.response.json().upstreams['product-service']).to.be.a('string'));",
                  "pm.test('has order-service URL', () => pm.expect(pm.response.json().upstreams['order-service']).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET / — Gateway Info",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/",
            "description": "Returns gateway routing table built from environment config."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('service is api-gateway', () => pm.expect(pm.response.json().service).to.equal('api-gateway'));",
                  "pm.test('routes present', () => pm.expect(pm.response.json().routes).to.be.an('object'));"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "name": "2 · User Service — via Gateway",
      "description": "All CRUD calls routed through the API gateway at /users/*. Gateway forwards to user-service internally.",
      "item": [
        {
          "name": "GET /users — List All Users",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/users",
            "description": "Proxied to user-service. Returns [] on a fresh start."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /users — Create User (Alice)",
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/users",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice@example.com\"\n}"
            },
            "description": "Creates Alice via the gateway. Saves userId to collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('userId', body.id);",
                  "pm.test('User has id', () => pm.expect(body.id).to.be.a('string'));",
                  "pm.test('User has name', () => pm.expect(body.name).to.equal('Alice Johnson'));",
                  "pm.test('User has email', () => pm.expect(body.email).to.equal('alice@example.com'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /users — Create User (Bob)",
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/users",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Smith\",\n  \"email\": \"bob@example.com\"\n}"
            },
            "description": "Creates Bob via the gateway."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /users/:id — Get User by ID",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/users/{{userId}}",
            "description": "Fetches Alice using the userId saved in the collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Correct user returned', () => {",
                  "    pm.expect(pm.response.json().id).to.equal(pm.collectionVariables.get('userId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /users/:id — Update User",
          "request": {
            "method": "PUT",
            "url": "{{gateway_url}}/users/{{userId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Johnson (Updated)\",\n  \"email\": \"alice.updated@example.com\"\n}"
            },
            "description": "Full update of Alice via the gateway."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Name updated', () => pm.expect(pm.response.json().name).to.include('Updated'));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /users/:id — Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{gateway_url}}/users/{{userId}}",
            "description": "Deletes Alice. Returns 204 No Content."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /users — Re-create Alice (for Order tests)",
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/users",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice@example.com\"\n}"
            },
            "description": "Re-creates Alice for Order tests. Saves new id to collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('userId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },


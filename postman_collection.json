{
  "info": {
    "_postman_id": "lab07-api-gateway-collection",
    "name": "Microservices – Lab 7 (API Gateway)",
    "description": "Complete test collection for Lab 07 — API Gateway + Config-based Service Discovery.\n\nArchitecture:\n  Client/Postman → api-gateway ({{gateway_url}})\n                   ├─ /users/*    → user-service    (internal)\n                   ├─ /products/* → product-service (internal)\n                   └─ /orders/*   → order-service   (internal)\n\nStart all services locally:\n  docker compose up -d\n\nHow to switch between local and cloud:\n  Import BOTH environment files, then pick the active one in Postman:\n  • postman_env_local.json → gateway_url = http://localhost:4000\n  • postman_env_cloud.json → gateway_url = https://lab07-api-gateway.onrender.com\n  The SAME collection runs against both — no changes needed.\n\nRecommended run order:\n  1. Gateway Health & Info\n  2. User Service — via Gateway\n  3. Product Service — via Gateway\n  4. Order Service — via Gateway\n  5. Gateway Error Scenarios (stop user-service first for 503 test)\n\nNote: Render free tier cold-starts after 15 min idle — first request may take ~30s.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:4000",
      "description": "Override via Postman Environment. Local: http://localhost:4000 | Cloud: https://lab07-api-gateway.onrender.com"
    },
    { "key": "userId",    "value": "", "description": "Auto-set by POST /users test script" },
    { "key": "productId", "value": "", "description": "Auto-set by POST /products test script" },
    { "key": "orderId",   "value": "", "description": "Auto-set by POST /orders test script" }
  ],
  "item": [

    {
      "name": "1 · Gateway Health & Info",
      "description": "Gateway-only endpoints. No proxying — handled entirely by the gateway itself.",
      "item": [
        {
          "name": "GET /health — Gateway Health Check",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/health",
            "description": "Returns gateway status, version, timestamp, and the upstream service URLs read from environment variables (proof of config-driven discovery)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status is ok', () => pm.expect(body.status).to.equal('ok'));",
                  "pm.test('service is api-gateway', () => pm.expect(body.service).to.equal('api-gateway'));",
                  "pm.test('has timestamp', () => pm.expect(body.timestamp).to.be.a('string'));",
                  "pm.test('upstreams object present', () => pm.expect(body.upstreams).to.be.an('object'));",
                  "pm.test('user-service URL set', () => pm.expect(body.upstreams['user-service']).to.be.a('string').and.not.be.empty);",
                  "pm.test('product-service URL set', () => pm.expect(body.upstreams['product-service']).to.be.a('string').and.not.be.empty);",
                  "pm.test('order-service URL set', () => pm.expect(body.upstreams['order-service']).to.be.a('string').and.not.be.empty);",
                  "console.log('Upstream URLs:', JSON.stringify(body.upstreams, null, 2));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET / — Gateway Routing Table",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/",
            "description": "Returns the gateway's routing table, built entirely from environment config at startup."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('service is api-gateway', () => pm.expect(body.service).to.equal('api-gateway'));",
                  "pm.test('routes present', () => pm.expect(body.routes).to.be.an('object'));"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "name": "2 · User Service — via Gateway",
      "description": "Full CRUD on /users/* — all calls routed through the API gateway to user-service internally.\nGateway path: {{gateway_url}}/users/* → user-service /users/*",
      "item": [
        {
          "name": "GET /users — List All Users",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/users",
            "description": "Proxied: gateway → user-service. Returns [] on fresh start."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /users — Create User (Alice)",
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/users",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice@example.com\"\n}"
            },
            "description": "Creates Alice via the gateway. Saves id to {{userId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('userId', body.id);",
                  "pm.test('User has id', () => pm.expect(body.id).to.be.a('string'));",
                  "pm.test('User name correct', () => pm.expect(body.name).to.equal('Alice Johnson'));",
                  "pm.test('User email correct', () => pm.expect(body.email).to.equal('alice@example.com'));",
                  "console.log('Saved userId:', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /users — Create User (Bob)",
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/users",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Smith\",\n  \"email\": \"bob@example.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /users/:id — Get User by ID",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/users/{{userId}}",
            "description": "Fetches Alice using the auto-saved {{userId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Correct user returned', () => {",
                  "    pm.expect(pm.response.json().id).to.equal(pm.collectionVariables.get('userId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /users/:id — Full Update User",
          "request": {
            "method": "PUT",
            "url": "{{gateway_url}}/users/{{userId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Johnson (Updated)\",\n  \"email\": \"alice.updated@example.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Name updated', () => pm.expect(pm.response.json().name).to.include('Updated'));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /users/:id — Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{gateway_url}}/users/{{userId}}",
            "description": "Deletes Alice. Returns 204 No Content."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /users — Re-create Alice (for Order tests)",
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/users",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice@example.com\"\n}"
            },
            "description": "Re-creates Alice so order tests have a valid userId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('userId', pm.response.json().id);",
                  "console.log('Re-created userId:', pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },

